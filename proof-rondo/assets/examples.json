        "| axiom assum {φ}, p :=",
        "| φ",
        "| .",
        "# ∧I, ∧E1, ∧E2",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ",
        "| q :: ψ",
        "| axiom and-i {φ}, {ψ}, p, q :=",
        "| φ ∧ ψ",
        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ ∧ ψ",
        "| axiom and-e1 {φ}, {ψ}, p :=",
        "| φ",
        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ ∧ ψ",
        "| axiom and-e2 {φ}, {ψ}, p :=",
        "| ψ",
        "| .",
        "# ∨I1, ∨I2, ∨E",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ",
        "| axiom or-i1 {φ}, {ψ}, p :=",
        "| φ ∨ ψ",
        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: ψ",
        "| axiom or-i2 {φ}, {ψ}, p :=",
        "| φ ∨ ψ",
        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| χ :: Form",
        "| p :: φ ∨ ψ",
        "| q :: (h :: φ) -> χ",
        "| r :: (h :: ψ) -> χ",
        "| axiom or-e {φ}, {ψ}, {χ}, p, q, r :=",

        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ → ψ",
        "| q :: φ",
        "| axiom ->-e {φ}, {ψ}, p, q :=",
        "| ψ",
        "| .",
        "# ⊥E",
        "| φ :: Form",
        "| p :: ⊥",
        "| axiom bot-e {φ}, p :=",

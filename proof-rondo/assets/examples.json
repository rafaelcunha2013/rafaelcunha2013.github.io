        "| ψ :: Form",
        "| p :: φ → ψ",
        "| q :: ψ → φ",
        "| axiom <->-i {φ}, {ψ}, p, q :=",
        "| φ ↔ ψ",
        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ ↔ ψ",
        "| axiom <->-e1 {φ}, {ψ}, p :=",
        "| φ → ψ",
        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ ↔ ψ",
        "| axiom <->-e2 {φ}, {ψ}, p :=",
        "| ψ → φ",
        "| .",
        "# =I, reflexivity (part2/8_fol-equality.tex:537-551)",
        "| t :: Univ",
        "| axiom =-i {t} :=",
        "| t = t",
        "| .",
        "# copy: a line again, by Ax",
        "| φ :: Form",
        "| p :: φ",
        "| def copy {φ}, p :=",
        "| φ : assum p",
        "| .",
        "# MT: from φ → ψ and ¬ψ, ¬φ",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ → ψ",
        "| q :: ¬ψ",
        "| def mt {φ}, {ψ}, p, q :=",
        "|| h :: φ",
        "|| s :: ψ : -> e p, h",
        "|| b :: ⊥ : neg e q, s",
        "| ¬φ : neg i h-b",
        "| .",
        "# Contra (part1/3_fitch-truth.tex:881-896)",
        "| φ :: Form",
        "| p :: (h :: ¬φ) -> ⊥",
        "| axiom contra {φ}, p :=",
        "| φ",
        "| .",
        "# ¬¬E, DNE (part1/5_fol-proofs.tex:770-790)",
        "| φ :: Form",
        "| p :: ¬¬φ",
        "| def notnot-e {φ}, p :=",
        "|| h :: ¬φ",
        "|| b :: ⊥ : neg e p, h",
        "| φ : contra h-b",
        "| .",
        "# LEM (part1/3_fitch-truth.tex:914-927)",
        "| φ :: Form",
        "| def lem {φ} :=",
        "|| h :: ¬(φ ∨ ¬φ)",
        "||| a :: φ",
        "||| s :: φ ∨ ¬φ : or i1 a",
        "||| b :: ⊥ : neg e h, s",
        "|| n :: ¬φ : neg i a-b",
        "|| t :: φ ∨ ¬φ : or i2 n",
        "|| c :: ⊥ : neg e h, t",

        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ",
        "| q :: ψ",
        "| axiom and-i {φ}, {ψ}, p, q :=",
        "| φ ∧ ψ",
        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ ∧ ψ",
        "| axiom and-e1 {φ}, {ψ}, p :=",
        "| φ",
        "| .",

        "| ψ :: Form",
        "| p :: φ ∧ ψ",
        "| axiom and-e2 {φ}, {ψ}, p :=",
        "| ψ",
        "| .",
        "# ∨I1, ∨I2, ∨E",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ",
        "| axiom or-i1 {φ}, {ψ}, p :=",
        "| φ ∨ ψ",
        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: ψ",
        "| axiom or-i2 {φ}, {ψ}, p :=",
        "| φ ∨ ψ",
        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| χ :: Form",
        "| p :: φ ∨ ψ",
        "| q :: (h :: φ) -> χ",
        "| r :: (h :: ψ) -> χ",
        "| axiom or-e {φ}, {ψ}, {χ}, p, q, r :=",
        "| χ",
        "| .",
        "# →I, →E",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: (h :: φ) -> ψ",
        "| axiom ->-i {φ}, {ψ}, p :=",
        "| φ → ψ",
        "| .",
        "| φ :: Form",
        "| ψ :: Form",
        "| p :: φ → ψ",
        "| q :: φ",
        "| axiom ->-e {φ}, {ψ}, p, q :=",
        "| ψ",
        "| .",
        "# ⊥E",
        "| φ :: Form",
        "| p :: ⊥",
        "| axiom bot-e {φ}, p :=",
